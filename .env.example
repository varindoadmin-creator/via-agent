# Meta WhatsApp Cloud API webhook. Store real values in Cloud Run Secret Manager.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# Optional inbound WATI webhook authentication. When set, the public callback
# route requires Authorization: Bearer <this value>.
WATI_WEBHOOK_SECRET=

# WATI outbound API (sendSessionMessage + addUpdateContactAttributes). Blank = sends log and no-op.
WATI_API_TOKEN=
WATI_API_BASE_URL=

# Phase 6 feature flags (brief section 80) — staged rollout, all off by
# default. Set to the literal string "true" to enable each stage; anything
# else (including unset) is treated as off. See
# docs/customer-operations-order-processing.md for what each stage unlocks.
CUSTOMER_IDENTITY_MAPPING_ENABLED=
NEW_CUSTOMER_ONBOARDING_ENABLED=
ZOHO_CUSTOMER_CREATION_ENABLED=
WATI_CONTACT_SYNC_ENABLED=
COMMERCIAL_DRAFT_ENABLED=
SALES_ORDER_EXECUTION_ENABLED=

# Phase 7 feature flags — customer self-service, staged rollout, all off by default.
CUSTOMER_ORDER_STATUS_ENABLED=
CUSTOMER_INVOICE_STATUS_ENABLED=
CUSTOMER_INVOICE_DOCUMENT_ENABLED=
CUSTOMER_PAYMENT_STATUS_ENABLED=
CUSTOMER_RECEIVABLE_SUMMARY_ENABLED=
CUSTOMER_DELIVERY_STATUS_ENABLED=

# Phase 8 feature flags — human handoff / customer service operations, staged rollout, all off by default.
CUSTOMER_SERVICE_HANDOFF_ENABLED=
AUTO_ASSIGNMENT_ENABLED=
CUSTOMER_SERVICE_SLA_ENABLED=
SLA_ESCALATION_ENABLED=
JARVIS_ADMIN_COPILOT_ENABLED=
SUGGESTED_REPLIES_ENABLED=
AUTO_RETURN_TO_VIA_ENABLED=
# Declared per the brief's own flag list, but its code path is a documented
# no-op -- no verified WATI operator/assignment API exists in this codebase.
WATI_ASSIGNMENT_SYNC_ENABLED=

# Phase 8 SLA tuning (sensible defaults apply if unset).
CS_SLA_WARNING_MINUTES=
CS_SLA_BREACH_MINUTES=
CS_SLA_PAUSE_OUTSIDE_HOURS=
CS_HOURS_TZ_OFFSET_MINUTES=
CS_HOURS_OPEN=
CS_HOURS_CLOSE=

# Phase 9 feature flags — customer service / sales / marketing analytics, staged rollout, all off by default.
ANALYTICS_EVENT_PIPELINE_ENABLED=
CUSTOMER_SERVICE_ANALYTICS_ENABLED=
COMMERCIAL_FUNNEL_ANALYTICS_ENABLED=
STOCK_ANALYTICS_ENABLED=
SOURCE_ATTRIBUTION_ANALYTICS_ENABLED=
JARVIS_MANAGEMENT_ANALYTICS_ENABLED=
ANOMALY_DETECTION_ENABLED=
MANAGEMENT_RECOMMENDATIONS_ENABLED=

# Phase 9 anomaly-detection thresholds (sensible defaults apply if unset).
ANOMALY_SLA_BREACH_RATE_THRESHOLD=
ANOMALY_VENDOR_RESPONSE_MINUTES_THRESHOLD=
ANOMALY_MIN_SAMPLE_SIZE=

# Phase 10 feature flags — proactive operational excellence, staged rollout, all off by default.
OPERATIONAL_DETECTION_ENABLED=
OPERATIONAL_FINDINGS_UI_ENABLED=
PROACTIVE_JARVIS_BRIEF_ENABLED=
MANAGEMENT_ALERTS_ENABLED=
OPPORTUNITY_DETECTION_ENABLED=
ACTION_PLANS_ENABLED=
AUTO_FINDING_RESOLUTION_ENABLED=

# Phase 10 detection tuning (sensible defaults apply if unset).
OPERATIONAL_MIN_SAMPLE_SIZE=
OPERATIONAL_PERSISTENCE_WINDOWS=
OPERATIONAL_UNASSIGNED_MINUTES_THRESHOLD=
OPERATIONAL_VENDOR_RESPONDED_MINUTES_THRESHOLD=
OPERATIONAL_APPROVED_NOT_EXECUTED_MINUTES=
OPERATIONAL_WORKFLOW_STUCK_MINUTES=
OPERATIONAL_QUOTATION_FOLLOWUP_HOURS=
